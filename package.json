{
  "name": "animal-cup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rm -rf .next && next dev -p 13000",
    "lan": "node script/lan-server.mjs",
    "dev:lan": "rm -rf .next && node script/lan-dev.mjs",
    "dev:lan:safe": "node script/lan-dev.mjs",
    "online": "node script/online-server.mjs",
    "dev:online": "rm -rf .next && node script/online-dev.mjs",
    "test:online": "node script/verify-online-relay.mjs",
    "test:online:browser": "node script/verify-online-browser.mjs",
    "deploy:online": "wrangler deploy -c wrangler-online.toml",
    "prebuild": "rm -rf .next",
    "build": "node script/stamp-sw-version.mjs && node script/safe-build.mjs",
    "build:worker": "rm -rf .next .open-next && node script/stamp-sw-version.mjs && opennextjs-cloudflare build",
    "start": "next start -p 13000",
    "test:pads": "node script/verify-pad-driver.mjs",
    "inspect:match": "node script/inspect-match-module.mjs",
    "test:lan:seats": "node script/verify-lan-seats.mjs",
    "test:lan:pad": "node script/verify-pad-seatpath.mjs",
    "test:lan:labels": "node script/verify-pad-labels.mjs",
    "test:lan:lobby": "node script/verify-pad-lobby.mjs",
    "test:lan:e2e": "node script/lan-e2e.mjs",
    "diag:lan:seats": "node script/diag-seat-errors.mjs",
    "test:lan": "node script/verify-lan-seats.mjs && node script/verify-pad-seatpath.mjs && node script/verify-pad-labels.mjs && node script/verify-pad-lobby.mjs",
    "test:lan:all": "node script/verify-lan-seats.mjs && node script/verify-pad-driver.mjs && node script/verify-pad-seatpath.mjs && node script/verify-pad-labels.mjs && node script/verify-pad-lobby.mjs && node script/lan-e2e.mjs"
  },
  "dependencies": {
    "next": "15.5.19",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@opennextjs/cloudflare": "^1.19.10",
    "@types/react": "19.2.17",
    "playwright-core": "^1.61.1",
    "sharp": "^0.34.5",
    "typescript": "5.8.2",
    "wrangler": "^4.86.0",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "workerd"
    ]
  }
}
